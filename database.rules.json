{
  "rules": {
    "tomatoes": {
      ".read": "true",
      "$tomatoId": {
        ".write": "auth != null && (newData.exists() || data.child('uid').val() === auth.uid || (auth.uid === 'C2FrKuBXBzRYcqCG7pW8eEzm5RI3' || auth.uid === '1uKGbtsFGOYKTwge7lT88yAfnx92' || auth.uid === 'ptNpn0JJF1Serl8Ej7yAJLtpPti2' || auth.uid === 'pJVYaoxxs2UReJ2bcp5VWSLvl6x2' || root.child('admins').child(auth.uid).val() === true))",
        "verified": {
          ".validate": "newData.isBoolean() && (newData.val() === false || (auth.uid === 'C2FrKuBXBzRYcqCG7pW8eEzm5RI3' || auth.uid === '1uKGbtsFGOYKTwge7lT88yAfnx92' || auth.uid === 'ptNpn0JJF1Serl8Ej7yAJLtpPti2' || auth.uid === 'pJVYaoxxs2UReJ2bcp5VWSLvl6x2' || root.child('admins').child(auth.uid).val() === true) || data.val() === true)"
        },
        "colorChecked": {
          ".validate": "newData.hasChildren(['by', 'at']) && (auth.uid === 'C2FrKuBXBzRYcqCG7pW8eEzm5RI3' || auth.uid === '1uKGbtsFGOYKTwge7lT88yAfnx92' || auth.uid === 'ptNpn0JJF1Serl8Ej7yAJLtpPti2' || auth.uid === 'pJVYaoxxs2UReJ2bcp5VWSLvl6x2')",
          "by": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "probableError": {
          ".validate": "newData.isBoolean()"
        },
        "uid": {
          ".validate": "!data.exists() ? newData.val() === auth.uid : true"
        },
        "cycle": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "semis": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "article": {
          ".validate": "newData.isString() && newData.val().length <= 30000"
        },
        "articleSource": {
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "url": {
            ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/fr\\.wikipedia\\.org\\//)"
          },
          "$other": {
            ".validate": false
          }
        },
        "likes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "contributors": {
          ".write": "auth != null"
        }
      }
    },
    "pepins": {
      ".read": "true",
      "admins": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === 'C2FrKuBXBzRYcqCG7pW8eEzm5RI3' || auth.uid === '1uKGbtsFGOYKTwge7lT88yAfnx92' || auth.uid === 'ptNpn0JJF1Serl8Ej7yAJLtpPti2' || auth.uid === 'pJVYaoxxs2UReJ2bcp5VWSLvl6x2')"
      },
      "colors": {
        "$colorId": {
          ".write": "auth != null && (auth.uid === 'C2FrKuBXBzRYcqCG7pW8eEzm5RI3' || auth.uid === '1uKGbtsFGOYKTwge7lT88yAfnx92' || auth.uid === 'ptNpn0JJF1Serl8Ej7yAJLtpPti2' || auth.uid === 'pJVYaoxxs2UReJ2bcp5VWSLvl6x2' || root.child('pepins/admins').child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['name', 'hex'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24 && newData.val().matches(/^[^<>&\"]+$/)"
          },
          "hex": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
          },
          "by": {
            ".validate": "newData.isString()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "tomatoes": {
        "$id": {
          ".write": "auth != null && (auth.uid === 'C2FrKuBXBzRYcqCG7pW8eEzm5RI3' || auth.uid === '1uKGbtsFGOYKTwge7lT88yAfnx92' || auth.uid === 'ptNpn0JJF1Serl8Ej7yAJLtpPti2' || auth.uid === 'pJVYaoxxs2UReJ2bcp5VWSLvl6x2' || root.child('pepins/admins').child(auth.uid).val() === true)",
          "cycle": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "semis": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "article": {
            ".validate": "newData.isString() && newData.val().length <= 30000"
          },
          "articleSource": {
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "url": {
              ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/fr\\.wikipedia\\.org\\//)"
            },
            "$other": {
              ".validate": false
            }
          },
          "likes": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          },
          "comments": {
            "$cid": {
              ".write": "auth != null && !data.exists()"
            }
          }
        }
      }
    },
    "admins": {
      ".read": "auth != null",
      ".write": "false"
    },
    "quest": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 300" },
        "days": { "$d": { ".validate": "newData.hasChildren()" } },
        "liked": { "$t": { ".validate": "newData.val() === true" } },
        "week": {
          "k": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "xp": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "lb": {
      ".read": "true",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 300" },
        "weeks": { "$w": { ".validate": "newData.isNumber() && newData.val() >= 0" } },
        "$other": { ".validate": false }
      }
    },
    "users": {
      "$uid": {
        ".read": "true",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "meta": {
      ".read": "true",
      ".write": "true"
    },
    "colors": {
      ".read": "true",
      "$colorId": {
        ".write": "auth != null && (auth.uid === 'C2FrKuBXBzRYcqCG7pW8eEzm5RI3' || auth.uid === '1uKGbtsFGOYKTwge7lT88yAfnx92' || auth.uid === 'ptNpn0JJF1Serl8Ej7yAJLtpPti2' || auth.uid === 'pJVYaoxxs2UReJ2bcp5VWSLvl6x2' || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['name', 'hex'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24 && newData.val().matches(/^[^<>&\"]+$/)"
        },
        "hex": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
        },
        "hex2": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
        },
        "by": {
          ".validate": "newData.isString()"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}